{
  "info": {
    "name": "LoyaltyPlus — WhatsApp OTP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://backend-dev-ccff.up.railway.app/api", "type": "string" },
    { "key": "token",   "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.access_token) {",
              "  pm.collectionVariables.set('token', json.access_token);",
              "  console.log('Token saved automatically');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password_here\"\n}"
        }
      }
    },
    {
      "name": "2. Save OTP Template Name",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/configuration/whatsapp",
          "host": ["{{baseUrl}}"],
          "path": ["configuration", "whatsapp"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"templateOtp\": \"registration_otp_message_logo_opia\"\n}"
        }
      }
    },
    {
      "name": "3. Send OTP WhatsApp Message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/configuration/whatsapp/send-otp",
          "host": ["{{baseUrl}}"],
          "path": ["configuration", "whatsapp", "send-otp"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"923001234567\",\n  \"code\": \"489231\",\n  \"customer_name\": \"Test Customer\"\n}"
        }
      }
    },
    {
      "name": "4. Save Redemption OTP Template Name",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/configuration/whatsapp",
          "host": ["{{baseUrl}}"],
          "path": ["configuration", "whatsapp"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"templateOtpRedemption\": \"otp_verification_logo_opia\"\n}"
        }
      }
    },
    {
      "name": "5. Send Redemption OTP WhatsApp Message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/configuration/whatsapp/send-redemption-otp",
          "host": ["{{baseUrl}}"],
          "path": ["configuration", "whatsapp", "send-redemption-otp"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"923001234567\",\n  \"code\": \"123456\",\n  \"customer_name\": \"Test Customer\"\n}"
        }
      }
    }
  ]
}
