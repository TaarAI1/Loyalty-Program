            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"RP-CUST-001\",\n  \"name\": \"Ahmed Khan\",\n  \"mobile\": \"3001234567\",\n  \"country_code\": \"92\",\n  \"email\": \"ahmed@example.com\",\n  \"dob\": \"1990-05-15\",\n  \"store\": \"Lahore\",\n  \"region\": \"Punjab\"\n}"
