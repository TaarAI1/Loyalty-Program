    {
      "name": "👥 Customers",
      "item": [
        {
          "name": "List All Customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&pageSize=50",
              "host": ["{{baseUrl}}"], "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "tierId", "value": "", "disabled": true },
                { "key": "store", "value": "", "disabled": true },
                { "key": "region", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Search Customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers?search=Ahmed&page=1&pageSize=20",
              "host": ["{{baseUrl}}"], "path": ["customers"],
              "query": [
                { "key": "search", "value": "Ahmed" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Customer Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Khan Updated\",\n  \"email\": \"ahmed.new@example.com\",\n  \"region\": \"Punjab\",\n  \"store\": \"Lahore\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"status\": \"active\",\n  \"isActive\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/history?page=1&pageSize=20",
              "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Transaction Items",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/transactions/{{transactionId}}/items", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "transactions", "{{transactionId}}", "items"] }
          }
        },
        {
          "name": "Get Points Ledger",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/points-ledger?page=1&pageSize=20",
              "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "points-ledger"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Award Points (Manual)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": 500,\n  \"reason\": \"Birthday gift\",\n  \"awardedBy\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/award-points", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "award-points"] }
          }
        },
        {
          "name": "Send WhatsApp Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_name\": \"points_earned_confirmation\",\n  \"message\": \"Optional custom message override\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/notify", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "notify"] }
          }
        }
      ]
