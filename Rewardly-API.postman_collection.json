            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"RP-CUST-002\",\n  \"name\": \"Sara Ali\",\n  \"mobile\": \"3119876543\",\n  \"country_code\": \"92\"\n}"
