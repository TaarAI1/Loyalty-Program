{
  "info": {
    "name": "Rewardly Loyalty Program API",
    "description": "Complete API collection for Rewardly Loyalty Management System. Set the {{baseUrl}} variable to your API base URL (e.g. https://api-dev.up.railway.app/api) and {{token}} after login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://your-api.up.railway.app/api", "type": "string" },
    { "key": "token",   "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  console.log('Token saved:', json.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },

    {
      "name": "❤️ Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },

    {
      "name": "🔗 Webhooks",
      "item": [
        {
          "name": "Transaction Webhook (Full)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"TXN-20260608-001\",\n  \"cust_sid\": \"RP-CUST-001\",\n  \"customer_mobile\": \"3001234567\",\n  \"customer_name\": \"Ahmed Khan\",\n  \"country_code\": \"92\",\n  \"sale_amount\": 50000,\n  \"tax_amount\": 2500,\n  \"gross_amount\": 52500,\n  \"net_amount\": 50000,\n  \"redeem_points\": 500,\n  \"transaction_date\": \"2026-06-08T14:30:00.000+05:00\",\n  \"store\": \"Lahore\",\n  \"region\": \"Punjab\",\n  \"receipt_no\": \"RCP-2026-001\",\n  \"outlet\": \"Ground Floor\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-001\",\n      \"description\": \"Premium Shirt\",\n      \"qty\": 2,\n      \"unit_price\": 15000,\n      \"total_price\": 30000,\n      \"tax_amount\": 1500,\n      \"gross_amount\": 31500,\n      \"net_amount\": 30000\n    },\n    {\n      \"sku\": \"SKU-002\",\n      \"description\": \"Casual Trousers\",\n      \"qty\": 1,\n      \"unit_price\": 20000,\n      \"total_price\": 20000,\n      \"tax_amount\": 1000,\n      \"gross_amount\": 21000,\n      \"net_amount\": 20000\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/transaction", "host": ["{{baseUrl}}"], "path": ["webhooks", "transaction"] }
          }
        },
        {
          "name": "Transaction Webhook (Minimal - mobile only required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_mobile\": \"3001234567\",\n  \"sale_amount\": 15000\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/transaction", "host": ["{{baseUrl}}"], "path": ["webhooks", "transaction"] }
          }
        },
        {
          "name": "Transaction Webhook (With Redemption)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"TXN-20260608-REDEEM-001\",\n  \"customer_mobile\": \"3001234567\",\n  \"customer_name\": \"Ahmed Khan\",\n  \"country_code\": \"92\",\n  \"sale_amount\": 25000,\n  \"tax_amount\": 1250,\n  \"gross_amount\": 26250,\n  \"redeem_points\": 1000,\n  \"transaction_date\": \"2026-06-08T16:00:00.000+05:00\",\n  \"store\": \"Karachi\",\n  \"region\": \"Sindh\"\n}"
