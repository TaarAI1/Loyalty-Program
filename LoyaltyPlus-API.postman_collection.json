{
  "info": {
    "name": "LoyaltyPlus API",
    "_postman_id": "loyaltyplus-api-collection",
    "description": "Complete Postman collection for the LoyaltyPlus backend API.\n\nSet the `baseUrl` variable to your API root (e.g. https://your-api.railway.app/api).\nSet the `token` variable after calling POST /auth/login.\n\nAll endpoints except those marked PUBLIC require the Authorization header:\n  Authorization: Bearer {{token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://backend-dev-ccff.up.railway.app/api", "type": "string" },
    { "key": "token",   "value": "",                                  "type": "string" },
    { "key": "customerId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "txId",    "value": "00000000-0000-0000-0000-000000000000", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.access_token) {",
                  "        pm.collectionVariables.set('token', json.access_token);",
                  "        console.log('Token saved:', json.access_token.substring(0, 20) + '...');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Customers",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers?search=&tierId=&region=&store=&page=1&pageSize=50",
              "host": ["{{baseUrl}}"], "path": ["customers"],
              "query": [
                { "key": "search",   "value": "",   "description": "Search by name / phone / email" },
                { "key": "tierId",   "value": "",   "description": "Filter by tier ID" },
                { "key": "region",   "value": "",   "description": "Filter by region" },
                { "key": "store",    "value": "",   "description": "Filter by store" },
                { "key": "page",     "value": "1"  },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}"] }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"region\": \"North\",\n  \"store\": \"HeadOffice\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"Female\",\n  \"status\": \"active\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/history?page=1&pageSize=20",
              "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","history"],
              "query": [{ "key": "page", "value": "1" }, { "key": "pageSize", "value": "20" }]
            }
          }
        },
        {
          "name": "Get Transaction Items",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/transactions/{{txId}}/items", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","transactions","{{txId}}","items"] }
          }
        },
        {
          "name": "Get Points Ledger",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/points-ledger?page=1&pageSize=20",
              "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","points-ledger"],
              "query": [{ "key": "page", "value": "1" }, { "key": "pageSize", "value": "20" }]
            }
          }
        },
        {
          "name": "Award Points",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/award-points", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","award-points"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": 500,\n  \"reason\": \"Birthday gift\",\n  \"awardedBy\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Send WhatsApp Notification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/notify", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","notify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_name\": \"points_earned_confirmation\",\n  \"message\": \"Optional override body\"\n}"
            }
          }
        },
        {
          "name": "Get Customer Activity",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/activity", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","activity"] }
          }
        },
        {
          "name": "Get Notes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/notes", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","notes"] }
          }
        },
        {
          "name": "Add Note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/notes", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","notes"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Customer called about missing points\",\n  \"addedBy\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/notes/1", "host": ["{{baseUrl}}"], "path": ["customers","{{customerId}}","notes","1"] }
          }
        },
        {
          "name": "Get Customer Persona",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/persona",
              "host": ["{{baseUrl}}"],
              "path": ["customers","{{customerId}}","persona"]
            },
            "description": "Returns persona fields for a customer: segment, engagementScore, occupation, gender, maritalStatus, preferredChannel, and all demographic fields."
          }
        },
        {
          "name": "Update Customer Persona",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/persona",
              "host": ["{{baseUrl}}"],
              "path": ["customers","{{customerId}}","persona"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"segment\": \"loyal\",\n  \"engagementScore\": 80,\n  \"occupation\": \"Engineer\",\n  \"gender\": \"Male\",\n  \"maritalStatus\": \"Single\",\n  \"preferredChannel\": \"WhatsApp\",\n  \"legalName\": null,\n  \"preferredName\": \"Ali\",\n  \"nationality\": \"Pakistani\",\n  \"city\": \"Lahore\",\n  \"area\": \"DHA\",\n  \"homeAddress\": null,\n  \"deliveryAddress\": null,\n  \"alternatePhone\": null,\n  \"dcsname\": null,\n  \"categories\": null\n}"
            },
            "description": "Updates persona fields. All fields are optional. Segment values: new, loyal, at_risk, vip, dormant. engagementScore is an integer (0-100). Gender: Male, Female, Other. MaritalStatus: Single, Married, Divorced, Widowed. PreferredChannel: WhatsApp, SMS, Email."
          }
        }
      ]
    },

